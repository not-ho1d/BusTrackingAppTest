<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Top Circle -->
    <item
        android:top="0dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="oval">
            <size android:width="24dp" android:height="24dp"/>
            <solid android:color="#1976D2"/>
        </shape>
    </item>

    <!-- Bottom Circle -->
    <item
        android:bottom="0dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="oval">
            <size android:width="24dp" android:height="24dp"/>
            <solid android:color="#1976D2"/>
        </shape>
    </item>

    <!-- Dotted Line -->
    <item
        android:top="24dp"
        android:bottom="24dp"
        android:left="20dp"
        android:right="20dp">
        <shape android:shape="rectangle">
            <size android:width="4dp"/>
            <stroke
                android:width="4dp"
                android:color="#1976D2"
                android:dashWidth="8dp"
                android:dashGap="4dp"/>
        </shape>
    </item>

</layer-list>
