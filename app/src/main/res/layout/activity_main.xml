<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/top_bar"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#0073FA"
        />
<!--    <ImageView-->
<!--        android:id="@+id/app_logo"-->
<!--        android:layout_width="30dp"-->
<!--        android:layout_height="30dp"-->
<!--        android:src="@mipmap/ic_launcher"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        app:layout_constraintBottom_toBottomOf="@+id/top_bar"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        />-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dhe... Bus"
        app:layout_constraintTop_toTopOf="@+id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/top_bar"
        android:fontFamily="@font/poppins_light"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:layout_marginLeft="20dp"
        />
    <ImageView
        android:id="@+id/settings"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_weight="1"
        android:layout_marginEnd="15dp"
        app:tint="@color/white"
        app:srcCompat="@drawable/settings"
        app:layout_constraintEnd_toEndOf="@+id/top_bar"
        app:layout_constraintBottom_toBottomOf="@+id/top_bar"
        app:layout_constraintTop_toTopOf="@+id/top_bar"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="-36dp"
        >

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="70dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/div"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="60dp"
                android:layout_height="match_parent">

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/circle" />

                <LinearLayout
                    android:layout_width="2dp"
                    android:layout_height="60dp"
                    android:layout_marginLeft="-10dp"
                    android:layout_marginTop="43dp"
                    android:layout_marginRight="-10dp"
                    android:orientation="vertical">
                    <!-- repeat small dots -->
                    <!--               <View-->
                    <!--                   android:layout_width="2dp"-->
                    <!--                   android:layout_height="4dp"-->
                    <!--                   android:background="#888888" />-->

                    <View
                        android:layout_width="2dp"
                        android:layout_height="4dp"
                        android:background="@android:color/transparent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="4dp"
                        android:background="#888888" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="4dp"
                        android:background="@android:color/transparent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="4dp"
                        android:background="#888888" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="4dp"
                        android:background="@android:color/transparent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="4dp"
                        android:background="#888888" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="4dp"
                        android:background="@android:color/transparent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="4dp"
                        android:background="#888888" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="4dp"
                        android:background="@android:color/transparent" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="4dp"
                        android:background="#888888" />
                </LinearLayout>


                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="-2dp"
                    android:layout_marginTop="86dp"
                    android:background="@drawable/circle" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="60dp">

                <AutoCompleteTextView
                    android:id="@+id/fromStand"
                    android:layout_width="300dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins_light"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:hint="From Stand"
                    android:inputType="textNoSuggestions"
                    android:textColor="@color/light_black"
                    android:textColorHint="#DD4B4A4A"></AutoCompleteTextView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@android:color/darker_gray" />

                <AutoCompleteTextView
                    android:id="@+id/toStand"
                    android:layout_width="300dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins_light"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:hint="To Stand"
                    android:inputType="textNoSuggestions"
                    android:textColor="@color/light_black"
                    android:textColorHint="#DD4B4A4A"></AutoCompleteTextView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/find_bus_button"
                android:layout_width="250dp"
                android:layout_height="45dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F3F8F6"
                    android:gravity="center_vertical|center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_light"
                        android:text="Find Bus"
                        android:textColor="@color/light_black"
                        android:textSize="18sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!--       <androidx.appcompat.widget.AppCompatButton-->
            <!--           android:layout_width="220dp"-->
            <!--           android:layout_height="40dp"-->
            <!--           android:text="Find Bus"-->
            <!--           android:background="@drawable/find_bus_button"-->
            <!--           android:layout_gravity="center_horizontal|bottom"-->
            <!--           android:layout_marginBottom="10dp"-->
            <!--           />-->

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            android:visibility="gone"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:layout_editor_absoluteX="0dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/view_map_button"
                android:layout_width="250dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F3F8F6"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="6"
                        android:fontFamily="@font/poppins_light"
                        android:text="View Live Map"
                        android:textColor="@color/light_black"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        app:srcCompat="@drawable/map_svgrepo_com" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


        </LinearLayout>
        <View
            android:layout_width="250dp"
            android:visibility="gone"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#E53935"
            android:layout_gravity="center_horizontal"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/driver_login_button"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#FFF5F5">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    app:srcCompat="@drawable/bus"
                    app:tint="#E53935"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Driver Access"
                    android:textSize="15sp"
                    android:textColor="#C62828"
                    android:fontFamily="@font/poppins_light"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>