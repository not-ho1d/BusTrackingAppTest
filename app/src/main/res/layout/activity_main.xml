<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#1976D2"
        android:elevation="4dp"
        app:title="Bus Tracker"
        app:titleTextColor="#FFFFFF"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

   <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="200dp"
       android:layout_marginTop="70dp"
       android:layout_marginEnd="10dp"
       android:layout_marginStart="10dp"
       app:layout_constraintTop_toTopOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       android:background="@drawable/div"
       android:orientation="horizontal">
       <LinearLayout
           android:layout_width="60dp"
           android:layout_height="match_parent">
            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/circle" />

           <LinearLayout
               android:layout_width="2dp"
               android:layout_height="60dp"
               android:orientation="vertical"
               android:layout_marginTop="43dp"
               android:layout_marginRight="-10dp"
               android:layout_marginLeft="-10dp">
               <!-- repeat small dots -->
<!--               <View-->
<!--                   android:layout_width="2dp"-->
<!--                   android:layout_height="4dp"-->
<!--                   android:background="#888888" />-->

               <View
                   android:layout_width="2dp"
                   android:layout_height="4dp"
                   android:background="@android:color/transparent" />

               <View
                   android:layout_width="2dp"
                   android:layout_height="4dp"
                   android:background="#888888" />

               <View
                   android:layout_width="2dp"
                   android:layout_height="4dp"
                   android:background="@android:color/transparent" />
               <View
                   android:layout_width="2dp"
                   android:layout_height="4dp"
                   android:background="#888888" />

               <View
                   android:layout_width="2dp"
                   android:layout_height="4dp"
                   android:background="@android:color/transparent" />

               <View
                   android:layout_width="2dp"
                   android:layout_height="4dp"
                   android:background="#888888" />

               <View
                   android:layout_width="2dp"
                   android:layout_height="4dp"
                   android:background="@android:color/transparent" />
               <View
                   android:layout_width="2dp"
                   android:layout_height="4dp"
                   android:background="#888888" />

               <View
                   android:layout_width="2dp"
                   android:layout_height="4dp"
                   android:background="@android:color/transparent" />

               <View
                   android:layout_width="2dp"
                   android:layout_height="4dp"
                   android:background="#888888" />

<!--               <View-->
<!--                   android:layout_width="2dp"-->
<!--                   android:layout_height="4dp"-->
<!--                   android:background="@android:color/transparent" />-->
<!--               <View-->
<!--                   android:layout_width="2dp"-->
<!--                   android:layout_height="4dp"-->
<!--                   android:background="#888888" />-->

<!--               <View-->
<!--                   android:layout_width="2dp"-->
<!--                   android:layout_height="4dp"-->
<!--                   android:background="@android:color/transparent" />-->

<!--               <View-->
<!--                   android:layout_width="2dp"-->
<!--                   android:layout_height="4dp"-->
<!--                   android:background="#888888" />-->

<!--               <View-->
<!--                   android:layout_width="2dp"-->
<!--                   android:layout_height="4dp"-->
<!--                   android:background="@android:color/transparent" />-->

           </LinearLayout>


           <View
               android:layout_width="20dp"
               android:layout_height="20dp"
               android:layout_marginStart="-2dp"
               android:layout_marginTop="86dp"
               android:background="@drawable/circle" />
       </LinearLayout>
       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="match_parent"
           android:orientation="vertical"
           android:paddingStart="60dp"
           >
           <AutoCompleteTextView
               android:id="@+id/fromStand"
               android:layout_width="300dp"
               android:layout_height="50dp"
               android:background="@android:color/transparent"
               android:hint="From Stand"
               android:textColor="@android:color/darker_gray"
               android:layout_marginTop="10dp"
               android:inputType="textNoSuggestions"
               ></AutoCompleteTextView>
           <View
               android:layout_width="match_parent"
               android:layout_height="1dp"
               android:background="@android:color/darker_gray"
               />
           <AutoCompleteTextView
               android:id="@+id/toStand"
               android:layout_width="300dp"
               android:layout_height="50dp"
               android:textColor="@android:color/darker_gray"
               android:inputType="textNoSuggestions"
               android:background="@android:color/transparent"
               android:hint="To Stand"
               android:layout_marginTop="10dp"
               ></AutoCompleteTextView>
       </LinearLayout>
       <androidx.appcompat.widget.AppCompatButton
           android:layout_width="220dp"
           android:layout_height="40dp"
           android:text="Find Bus"
           android:background="@drawable/find_bus_button"
           android:layout_gravity="center_horizontal|bottom"
           android:layout_marginBottom="10dp"
           />

   </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>