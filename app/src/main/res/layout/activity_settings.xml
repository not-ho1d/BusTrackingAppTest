<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Settings">
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1976D2"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:src="@drawable/arrow_left"
            app:tint="@color/white"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/white"
            android:layout_marginTop="2sp"
            android:textSize="17sp"
            android:fontFamily="@font/poppins_light"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/save"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="90dp"
            android:src="@drawable/save"
            app:tint="@color/white"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/server_ip_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/server_ip_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server url"
            android:layout_marginStart="20dp"
            android:fontFamily="@font/poppins_light"
            app:layout_constraintTop_toTopOf="@+id/server_ip_layout"
            app:layout_constraintBottom_toBottomOf="@+id/server_ip_layout"
            app:layout_constraintStart_toStartOf="parent" />
        <EditText
            android:id="@+id/server_url"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:hint="Enter server url"
            android:inputType="textUri"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:gravity="start|center_vertical"
            android:textAlignment="viewStart"
            android:textColor="#D8000000"
            android:paddingStart="10dp"
            app:layout_constraintStart_toEndOf="@+id/server_ip_indicator"
            app:layout_constraintTop_toTopOf="@id/server_ip_layout"
            app:layout_constraintBottom_toBottomOf="@id/server_ip_layout"
            android:layout_marginRight="5dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>