<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#D32F2F"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:src="@drawable/arrow_left"
            app:tint="@color/white"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/white"
            android:layout_marginTop="2sp"
            android:textSize="17sp"
            android:fontFamily="@font/poppins_light"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>


    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                android:padding="15dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- TITLE ROW -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp"
                        >

                        <TextView
                            android:layout_height="30dp"
                            android:layout_width="wrap_content"
                            android:text="Takeoff's"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:textSize="15sp"
                            android:layout_weight="1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:gravity="center"
                            android:layout_height="30dp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:text="Return's"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:layout_weight="1"/>
                    </LinearLayout>


                    <!-- REPEAT ROWS -->

                    <!-- ROW 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/to1"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textColorHint="@color/hint_color"
                            android:layout_height="45dp"
                            android:hint="Takeoff 1"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:inputType="time"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>

                        <EditText
                            android:id="@+id/rt1"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/hint_color"
                            android:fontFamily="@font/poppins_light"
                            android:layout_height="45dp"
                            android:hint="Return 1"
                            android:inputType="time"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>
                    </LinearLayout>

                    <!-- ROW 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/to2"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="45dp"
                            android:hint="Takeoff 2"
                            android:textColorHint="@color/hint_color"
                            android:inputType="time"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>

                        <EditText
                            android:id="@+id/rt2"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:layout_height="45dp"
                            android:textColorHint="@color/hint_color"
                            android:hint="Return 2"
                            android:inputType="time"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>
                    </LinearLayout>

                    <!-- ROW 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/to3"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textColorHint="@color/hint_color"
                            android:layout_height="45dp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:hint="Takeoff 3"
                            android:inputType="time"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>

                        <EditText
                            android:id="@+id/rt3"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textColorHint="@color/hint_color"
                            android:layout_marginStart="10dp"
                            android:layout_height="45dp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:hint="Return 3"
                            android:inputType="time"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>
                    </LinearLayout>

                    <!-- ROW 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:textColorHint="@color/hint_color"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_light"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/to4"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="45dp"
                            android:hint="Takeoff 4"
                            android:textColorHint="@color/hint_color"
                            android:inputType="time"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>

                        <EditText
                            android:id="@+id/rt4"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:layout_height="45dp"
                            android:textColorHint="@color/hint_color"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:hint="Return 4"
                            android:inputType="time"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>
                    </LinearLayout>

                    <!-- ROW 5 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/to5"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="45dp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:textColorHint="@color/hint_color"
                            android:hint="Takeoff 5"
                            android:inputType="time"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>

                        <EditText
                            android:id="@+id/rt5"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:layout_height="45dp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:textColorHint="@color/hint_color"
                            android:hint="Return 5"
                            android:inputType="time"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>
                    </LinearLayout>

                    <!-- ROW 6 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/to6"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="45dp"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:hint="Takeoff 6"
                            android:textColorHint="@color/hint_color"
                            android:inputType="time"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>

                        <EditText
                            android:id="@+id/rt6"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_light"
                            android:layout_marginStart="10dp"
                            android:layout_height="45dp"
                            android:hint="Return 6"
                            android:textColorHint="@color/hint_color"
                            android:inputType="time"
                            android:background="@drawable/time_box"
                            android:padding="10dp"/>
                    </LinearLayout>


                    <!-- BUTTON ROW -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="10dp">

                        <Button
                            android:id="@+id/save_btn"
                            android:text="Save"
                            android:textColor="@color/white"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="45dp"
                            android:backgroundTint="#D32F2F"/>

                        <Button
                            android:id="@+id/clear_btn"
                            android:text="Clear"
                            android:textColor="@color/white"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_height="45dp"
                            android:backgroundTint="#D32F2F"/>

                        <Button
                            android:id="@+id/delete_btn"
                            android:text="Delete"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textColor="@color/white"
                            android:layout_marginStart="8dp"
                            android:layout_height="45dp"
                            android:backgroundTint="#D32F2F"/>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>