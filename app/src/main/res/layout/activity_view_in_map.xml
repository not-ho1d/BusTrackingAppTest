<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ViewInMap">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1976D2"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:src="@drawable/arrow_left"
            app:tint="@color/white"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View in Map"
            android:textColor="@color/white"
            android:layout_marginTop="2sp"
            android:textSize="17sp"
            android:fontFamily="@font/poppins_light"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">


        <!-- Bottom Sheet -->
        <LinearLayout
            android:id="@+id/bottomSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bottom_sheet_bg"
            android:padding="22dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <!-- Drag Handle -->
            <View
                android:layout_width="45dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:layout_marginBottom="18dp"
                android:background="#D0D0D0"/>

            <!-- Bus Arrival Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/input_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Top Row (Time + Bell) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/arrivalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="06:23 AM"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#2B7CFF"
                        android:fontFamily="@font/poppins_light"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <ImageView
                        android:id="@+id/bell"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/bell"
                        android:background="@drawable/bell_bg_selector"
                        android:padding="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Notify when bus arrives"/>
                </LinearLayout>

                <!-- Bus Name -->
                <TextView
                    android:id="@+id/busName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bus 04"
                    android:textSize="15sp"
                    android:textColor="#111111"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/poppins_light"/>

                <!-- Route Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/routeName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thonichal → Kellur"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:fontFamily="@font/poppins_light"/>

                    <TextView
                        android:id="@+id/predictedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Predicted"
                        android:textSize="10sp"
                        android:textColor="#2B7CFF"
                        android:background="@drawable/predicted_badge_bg"
                        android:paddingLeft="7dp"
                        android:paddingRight="7dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins_light"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Title Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Want better results?"
                    android:textSize="20sp"
                    android:textColor="#1A1A1A"
                    android:fontFamily="@font/poppins_light"/>


            </RelativeLayout>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help improve bus timing accuracy."
                android:textSize="12sp"
                android:textColor="#777777"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/poppins_light"/>

            <!-- Question -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Was the bus early or late?"
                android:textSize="13sp"
                android:textColor="#333333"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/poppins_light"/>

            <!-- Options -->
            <RadioGroup
                android:id="@+id/statusGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/early"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Early"
                    android:textSize="12sp"
                    android:textColor="#444444"
                    android:fontFamily="@font/poppins_light"/>

                <RadioButton
                    android:id="@+id/ontime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="On time"
                    android:textSize="12sp"
                    android:textColor="#444444"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/poppins_light"/>

                <RadioButton
                    android:id="@+id/late"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Late"
                    android:textSize="12sp"
                    android:textColor="#444444"
                    android:layout_marginStart="14dp"
                    android:fontFamily="@font/poppins_light"/>

            </RadioGroup>

            <!-- Late Minutes -->
            <EditText
                android:id="@+id/lateMinutes"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:hint="Minutes late"
                android:textColorHint="#C0000000"
                android:textSize="13sp"
                android:inputType="number"
                android:textColor="@color/black"
                android:background="@drawable/input_bg"
                android:padding="10dp"
                android:visibility="gone"
                android:fontFamily="@font/poppins_light"/>

            <!-- Early Minutes -->
            <EditText
                android:id="@+id/earlyMinutes"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:hint="Minutes early"
                android:textColorHint="#C0000000"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:inputType="number"
                android:background="@drawable/input_bg"
                android:padding="10dp"
                android:visibility="gone"
                android:fontFamily="@font/poppins_light"/>

            <!-- Submit -->
            <Button
                android:id="@+id/submit"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="Submit"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#2B7CFF"
                android:fontFamily="@font/poppins_light"/>

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</androidx.constraintlayout.widget.ConstraintLayout>